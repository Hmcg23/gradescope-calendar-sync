{
  "manifest_version": 3,
  "name": "Gradescope → Calendar",
  "version": "1.0.0",
  "description": "Mirrors your Gradescope assignment deadlines into a dedicated Google Calendar, once a day.",
  "minimum_chrome_version": "116",

  "key": "",

  "oauth2": {
    "client_id": "315618860559-95mlidap99mfnti2hoflgpompft75pb8.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.app.created"]
  },

  "permissions": ["storage", "alarms", "scripting", "identity", "notifications", "tabs"],
  "host_permissions": ["https://www.gradescope.com/*"],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Gradescope → Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "src/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/parse.js"],
      "matches": ["https://www.gradescope.com/*"]
    }
  ]
}
